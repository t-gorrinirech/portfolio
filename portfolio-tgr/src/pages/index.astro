---
// Importamos tus estilos (Astro lo maneja en el servidor)
import { Image } from 'astro:assets';
import '../styles/style.css';
import machinesData from '../data/machines.json';
import pdfIcon from '../assets/pdf-icon.svg';
import translateIcon from '../assets/translate.png';
import pythonIcon from '../assets/pythonlogo.png';
import bashIcon from '../assets/bashlogo.png';
import linuxIcon from '../assets/linuxlogo.png';
import nmapIcon from '../assets/nmaplogo.png';
import cambridgeIcon from '../assets/cambridge.png';
import hack4uIcon from '../assets/hack4u.png';
import udemyLogo from '../assets/udemy.png';
import caidoLogo from '../assets/caido-removebg-preview.png';
import wireLogo from '../assets/wirelogo.svg.png';
import hackeroneIcon from '../assets/hackeronelogo.png';
import yeswehackIcon from '../assets/yeswehacklogo.png';
import reportThumb from '../assets/thumb_report.jpg';
import writeupThumb from '../assets/thumb_writeup.jpg';
import tomas from '../assets/tomas.jpeg';


---

<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#030303" />
    <title>Tomas G. Rech | Pentester</title>
    <link rel="icon" href={tomas.src} type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;600;700;800&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" /></noscript>

    <!-- Resolve the `ogl` bare import for the inline module script below. The script is
         kept `is:inline` on purpose so Astro never generates its processed-script dev URL
         (`index.astro?astro&type=script...`), whose unescaped `&` breaks the first load in
         Chrome. `ogl` is vendored to /vendor/ogl.js (see public/) so this works in dev+build. -->
    <script type="importmap" is:inline>
        { "imports": { "ogl": "/vendor/ogl.js" } }
    </script>
</head>

<body>
    <a href="#main" class="skip-link" data-i18n="skip_link">Skip to content</a>
    <div id="faulty-terminal-bg" class="global-bg"></div>

    <div class="container">
        <nav class="navbar" id="navbar">
            <div class="nav-content">
                <button class="logo" id="logo-home" type="button" translate="no" aria-label="Scroll to top">
                    <span class="dot"></span>
                    Tomás <span class="cursor" id="nav-cursor">_</span>
                </button>

                <div class="nav-right">
                    <ul class="nav-links" id="nav-links">
                        <li><a href="#" data-i18n="nav_home">HOME</a></li>
                        <li><a href="#experience" data-i18n="nav_experience">EXPERIENCE</a></li>
                        <li><a href="#certifications" data-i18n="nav_certifications">CERTIFICATIONS</a></li>
                        <li><a href="#contact" data-i18n="nav_contact">CONTACT</a></li>
                    </ul>

                    <div class="nav-controls">
                        <div class="lang-container">
                            <button id="lang-toggle" class="lang-btn">ES</button>
                            <Image src={translateIcon} format="webp" alt="" width={30} height={30} class="lang-icon" decoding="async" aria-hidden="true" />
                        </div>

                        <button class="hamburger" id="hamburger" aria-label="Menu">
                            <span></span>
                            <span></span>
                            <span></span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>

        <header class="hero" id="main">
            <div class="big-terminal-anim">
                <div class="terminal-line" id="terminal-line-container" translate="no">
                    <span class="prompt" id="prompt-symbol">~$</span>
                    <span class="command" id="typed-command"></span><span class="blinking-cursor" id="cursor">_</span>
                </div>
            </div>

             <div class="actions centered-actions">
                <!-- Reemplazamos la etiqueta <a> por un <button> con ID -->
                <button id="resume-btn" class="btn-primary">
                    <!-- El data-i18n va directo al span -->
                    <span data-i18n="btn_view">CV</span>
                    <img src={pdfIcon.src} alt="" width="20" height="20" aria-hidden="true" />
                </button>
                
                <a href="https://github.com/t-gorrinirech" target="_blank" class="text-link">GitHub</a>
                <span class="separator">|</span>
                <a href="https://www.linkedin.com/in/tomasgorrini/" target="_blank" class="text-link">LinkedIn</a>
            </div>

            <p class="terminal-path" data-i18n="path_whois">~/who-is/Tomás</p>
            <h1 data-i18n="hero_title">
                IT Student and<br />
                <span class="text-cyan">Pentester</span>
            </h1>

            <p class="subtitle" data-i18n="hero_subtitle">
                I'm a 4th-year IT student at <a href="https://uade.edu.ar/" target="_blank" class="underline-link">UADE</a>, focused on Web Pentesting and Red Teaming. I recently delivered a full <strong>security audit</strong> for a real e-commerce client (39 findings, scored with CVSS 3.1), and I hunt bugs on HackerOne and YesWeHack. I practice constantly on <a href="https://app.hackthebox.com" target="_blank" class="underline-link">HackTheBox</a>, chaining vulnerabilities from enumeration to exploitation. My English is C1 level, so I'm comfortable on international teams and I can write clear, detailed reports.
            </p>

            <ul class="subtitle-mobile" data-i18n="hero_subtitle_bullets" translate="no"></ul>

            <div class="stats-grid" translate="no">
                <div class="stat-card">
                    <div class="icon-box">
                        <Image src={pythonIcon} format="webp" alt="Python" width={100} height={100} decoding="async" />
                    </div>
                    <h3>Python</h3>
                </div>
                <div class="stat-card">
                    <div class="icon-box">
                        <Image src={bashIcon} format="webp" alt="Bash" width={100} height={100} decoding="async" />
                    </div>
                    <h3>Bash Scripting</h3>
                </div>
                <div class="stat-card">
                    <div class="icon-box">
                        <Image src={linuxIcon} format="webp" alt="Linux" width={100} height={100} decoding="async" />
                    </div>
                    <h3>Linux Systems</h3>
                </div>
                <div class="stat-card">
                    <div class="icon-box">
                        <Image src={caidoLogo} format="webp" alt="Caido" width={100} height={100} decoding="async" />
                    </div>
                    <h3>Caido</h3>
                </div>
                <div class="stat-card">
                    <div class="icon-box">
                        <Image src={wireLogo} format="webp" alt="Wireshark" width={100} height={100} decoding="async" />
                    </div>
                    <h3>Wireshark</h3>
                </div>
                <div class="stat-card">
                    <div class="icon-box">
                        <Image src={nmapIcon} format="webp" alt="Nmap" width={100} height={100} decoding="async" />
                    </div>
                    <h3 data-i18n="stat_tools">Offensive Security Tooling</h3>
                </div>
            </div>
        </header>

        <section class="experience" id="experience">
            <div class="section-header">
                <div>
                    <p class="terminal-path" data-i18n="path_experience">~/var/log/experience</p>
                    <h2 data-i18n="title_experience">Experience</h2>
                </div>
            </div>

            <div class="experience-grid">
                <!-- Arriba (ancho completo): Trabajo Profesional -->
                <div class="exp-block exp-block-full">
                    <h3 class="exp-label"><span class="exp-prompt">&gt;</span> <span data-i18n="exp_professional">Professional Work</span></h3>
                    <div class="exp-card exp-doc-card">
                        <button class="doc-thumb" data-doc="/redacted_writeup.pdf" aria-label="Preview security audit report">
                            <Image src={reportThumb} format="webp" alt="" width={140} height={140} class="doc-thumb-img" loading="lazy" decoding="async" aria-hidden="true" />
                        </button>
                        <div class="doc-actions">
                            <button class="btn-primary doc-btn" data-doc="/redacted_writeup.pdf">
                                <span data-i18n="btn_preview">Preview</span>
                                <img src={pdfIcon.src} alt="" width="18" height="18" aria-hidden="true" />
                            </button>
                            <a class="doc-btn doc-btn-outline" href="/redacted_writeup.pdf" download>
                                <span data-i18n="btn_download">Download</span>
                            </a>
                        </div>
                        <p class="doc-summary text-muted" data-i18n="exp_professional_desc">Delivered a comprehensive security audit report for an argentine E-Commerce, documenting 39 vulnerabilities (13 Critical, 8 High via CVSS 3.1), providing root-cause analyses, technical evidence, and actionable remediation measures for each finding.</p>
                    </div>
                </div>

                <!-- Fila inferior: Bug Bounty (izq) | Proyectos Personales (der) -->
                <div class="exp-row">
                    <div class="exp-block">
                        <h3 class="exp-label"><span class="exp-prompt">&gt;</span> <span data-i18n="exp_bugbounty">Bug Bounty</span></h3>
                        <div class="exp-card">
                            <p class="text-muted" data-i18n="exp_bugbounty_desc">Active bug bounty hunter under the handle <strong>tgxrech</strong> on:</p>
                            <ul class="exp-accounts">
                                <li>
                                    <Image src={hackeroneIcon} format="webp" alt="" width={42} height={42} class="exp-account-icon" loading="lazy" decoding="async" aria-hidden="true" />
                                    <div class="exp-account-text">
                                        <span class="exp-platform" translate="no">HackerOne</span>
                                        <a href="https://hackerone.com/tgxrech?type=user" target="_blank" rel="noopener" class="underline-link" translate="no">tgxrech</a>
                                    </div>
                                </li>
                                <li>
                                    <Image src={yeswehackIcon} format="webp" alt="" width={42} height={42} class="exp-account-icon" loading="lazy" decoding="async" aria-hidden="true" />
                                    <div class="exp-account-text">
                                        <span class="exp-platform" translate="no">YesWeHack</span>
                                        <a href="https://yeswehack.com/hunters/tgxrech#latest-hacktivity" target="_blank" rel="noopener" class="underline-link" translate="no">tgxrech</a>
                                    </div>
                                </li>
                            </ul>

                            <button class="doc-strip" data-doc="/openredirect_writeup.pdf" aria-label="Preview Open Redirect writeup">
                                <span class="doc-strip-thumb">
                                    <Image src={writeupThumb} format="webp" alt="" width={96} height={72} class="doc-thumb-img" loading="lazy" decoding="async" aria-hidden="true" />
                                </span>
                                <span class="doc-strip-info">
                                    <span class="doc-strip-title" data-i18n="bb_writeup_title" translate="no">Open Redirect (CWE-601) Writeup</span>
                                    <span class="doc-strip-hint" data-i18n="bb_writeup_hint">Click to preview</span>
                                </span>
                            </button>
                        </div>
                    </div>

                    <div class="exp-block">
                        <h3 class="exp-label"><span class="exp-prompt">&gt;</span> <span data-i18n="exp_projects">Personal Projects</span></h3>
                        <div class="projects-list">
                            <div class="project-item project-item-empty">
                                <div class="project-info">
                                    <h4 data-i18n="proj_placeholder_title">Working on some stuff…</h4>
                                    <p class="text-muted" data-i18n="proj_placeholder_desc">Scripts and tools are on the way. Check back soon.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="achievements" id="achievements_box">
            <div class="section-header">
                <div>
                    <p class="terminal-path" data-i18n="path_achievements">~/my/recent/achievements</p>
                    <h2 data-i18n="title_machines">Machines Completed</h2>
                </div>
                <div class="total-count">
                    <span class="text-muted" id="machines-counter">Total: 0 machines</span>
                    <span class="block-cursor"></span>
                </div>
            </div>

            <div class="filters-container">
                <div class="filter-group">
                    <label for="filter-difficulty" data-i18n="filter_diff">Difficulty:</label>
                    <select id="filter-difficulty" class="custom-select">
                        <option value="ALL" data-i18n="opt_all">All</option>
                        <option value="EASY" data-i18n="opt_easy">Easy</option>
                        <option value="MEDIUM" data-i18n="opt_medium">Medium</option>
                        <option value="HARD" data-i18n="opt_hard">Hard</option>
                        <option value="INSANE" data-i18n="opt_insane">Insane</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="filter-os" data-i18n="filter_os">Operating System:</label>
                    <select id="filter-os" class="custom-select">
                        <option value="ALL" data-i18n="opt_all_os">All</option>
                        <option value="Windows">Windows</option>
                        <option value="Linux">Linux</option>
                        <option value="Other" data-i18n="opt_other">Other</option>
                    </select>
                </div>
            </div>

            <div class="carousel-wrapper">
                <button class="carousel-btn prev" id="carousel-prev" aria-label="Previous machines">&lt;</button>
                
                <div class="carousel-track-container">
                    <div class="machines-track" id="machines-track"></div>
                    <div id="no-results-msg" class="no-results hidden">
                        <p class="text-muted" data-i18n="no_results">No machines found matching the selected filters.</p>
                    </div>
                </div>

                <button class="carousel-btn next" id="carousel-next" aria-label="Next machines">&gt;</button>
            </div>
        </section>

        <section class="certifications" id="certifications">
            <div class="section-header">
                <div>
                    <p class="terminal-path" data-i18n="path_certs">~/education/certifications</p>
                    <h2 data-i18n="title_certs">Certifications</h2>
                </div>
            </div>

            <div class="certs-list">
                <div class="cert-item">
                    <div class="cert-date" id="cert-ongoing" data-i18n="cert_ongoing_date">ONGOING</div>
                    <div class="cert-details">
                        <h3 data-i18n="cert_4_title">Introduction to Hacking</h3>
                        <p class="text-muted"><a href="https://hack4u.io/" class="underline-link" data-i18n="cert_4_issuer" target="_blank">Hack4u</a></p>
                    </div>
                    <div class="cert-logo">
                        <Image src={hack4uIcon} format="webp" alt="Hack4u Logo" width={70} height={70} loading="lazy" decoding="async" />
                    </div>
                </div>
                <div class="cert-item">
                    <div class="cert-date">2022</div>
                    <div class="cert-details">
                        <h3 data-i18n="cert_1_title">C1 Advanced</h3>
                        <p class="text-muted"><a href="https://www.cambridgeenglish.org/exams-and-tests/qualifications/advanced/" class="underline-link" data-i18n="cert_1_issuer" target="_blank">Cambridge University</a></p>
                    </div>
                    <div class="cert-logo">
                        <Image src={cambridgeIcon} format="webp" alt="Cambridge Logo" width={70} height={70} loading="lazy" decoding="async" />
                    </div>
                </div>

                <div class="cert-item">
                    <div class="cert-date">2026</div>
                    <div class="cert-details">
                        <h3 data-i18n="cert_2_title">Introduction to Linux</h3>
                        <p class="text-muted"><a href="https://hack4u.io/" class="underline-link" data-i18n="cert_2_issuer" target="_blank">Hack4u</a></p>
                    </div>
                    <div class="cert-logo">
                        <Image src={hack4uIcon} format="webp" alt="Hack4u Logo" width={70} height={70} loading="lazy" decoding="async" />
                    </div>
                </div>

                <div class="cert-item">
                    <div class="cert-date">2025</div>
                    <div class="cert-details">
                        <h3 data-i18n="cert_3_title">The Git & GitHub Bootcamp</h3>
                        <p class="text-muted"><a href="https://www.udemy.com" class="underline-link" target="_blank" rel="noopener">Udemy</a></p>
                    </div>
                    <div class="cert-logo">
                        <Image src={udemyLogo} format="webp" alt="Udemy Logo" width={70} height={70} loading="lazy" decoding="async" />
                    </div>
                </div>
            </div>
        </section>

        <section class="contact-section" id="contact">
            <div class="section-header">
                <div>
                    <p class="terminal-path" data-i18n="path_contact">~/network/connections</p>
                    <h2 data-i18n="title_contact">Get in Touch</h2>
                </div>
            </div>
            <div class="contact-box">
                <p class="text-muted" data-i18n="desc_contact">I'm always open to discussing new projects or opportunities.</p>
                <div class="contact-links">
                    <a href="mailto:tgorrinirech@gmail.com" class="btn-primary">tgorrinirech@gmail.com</a>
                    <a href="https://www.linkedin.com/in/tomasgorrini/" target="_blank" class="text-link" style="font-size: 1rem; font-weight: 600;">LinkedIn Profile &rarr;</a>
                </div>
            </div>
        </section>
    </div>

    <a href="mailto:tgorrinirech@gmail.com" class="mail-fab" id="mail-fab" aria-label="Send an email">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 6-10 7L2 6"></path>
        </svg>
    </a>

    <!-- Machines data injected server-side, read by the inline script below (keeps the
         script `is:inline` so no processed-script dev URL is generated). -->
    <script type="application/json" id="machines-data" is:inline set:html={JSON.stringify(machinesData).replace(/</g, '\\u003c')}></script>

    <script is:inline type="module">
        import { Renderer, Program, Mesh, Color, Triangle } from 'ogl';
        const machinesData = JSON.parse(document.getElementById('machines-data').textContent);

        // ==========================================
        // 0. SISTEMA DE TRADUCCIÓN (DICCIONARIO)
        // ==========================================
