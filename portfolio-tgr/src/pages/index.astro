---
// Importamos tus estilos (Astro lo maneja en el servidor)
import '../styles/style.css';
import '../data/machines.json';
import pdfIcon from '../assets/pdf-icon.svg';
import translateIcon from '../assets/translate.png';
import pythonIcon from '../assets/pythonlogo.png';
import bashIcon from '../assets/bashlogo.png';
import linuxIcon from '../assets/linuxlogo.png';
import nmapIcon from '../assets/nmaplogo.png';
import cambridgeIcon from '../assets/cambridge.png';
import hack4uIcon from '../assets/hack4u.png';
import udemyLogo from '../assets/udemy.png';
import burpLogo from '../assets/burplogo.svg.png';
import wireLogo from '../assets/wirelogo.svg.png';
import tomas from '../assets/tomas.jpeg';


---

<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tomas G. Rech | Pentester</title>
    <link rel="icon" href={tomas.src} type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
</head>

<body>
    <div id="faulty-terminal-bg" class="global-bg"></div>

    <div class="container">
        <nav class="navbar" id="navbar">
            <div class="nav-content">
                <div class="logo">
                    <span class="dot"></span>
                    Tomás <span class="cursor" id="nav-cursor">_</span>
                </div>
                
                <button class="hamburger" id="hamburger" aria-label="Menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <ul class="nav-links" id="nav-links">
                    <li><a href="#" data-i18n="nav_home">HOME</a></li>
                    <li><a href="#achievements_box" data-i18n="nav_machines">MACHINES</a></li>
                    <li><a href="#certifications" data-i18n="nav_certifications">CERTIFICATIONS</a></li>
                    <li><a href="#contact" data-i18n="nav_contact">CONTACT</a></li>
                    <li class="lang-container">
                        <button id="lang-toggle" class="lang-btn">ES</button> 
                        <img src={translateIcon.src} alt="Translate" class="lang-icon" decoding="async" /> 
                    </li>
                </ul>
            </div>
        </nav>

        <header class="hero">
            <div class="big-terminal-anim">
                <div class="terminal-line" id="terminal-line-container">
                    <span class="prompt" id="prompt-symbol">~$</span>
                    <span class="command" id="typed-command"></span><span class="blinking-cursor" id="cursor">_</span>
                </div>
            </div>

             <div class="actions centered-actions">
                <!-- Reemplazamos la etiqueta <a> por un <button> con ID -->
                <button id="resume-btn" class="btn-primary">
                    <!-- El data-i18n va directo al span -->
                    <span data-i18n="btn_view">CV</span>
                    <img src={pdfIcon.src} alt="PDF" width="20" height="20" />
                </button>
                
                <a href="https://github.com/t-gorrinirech" target="_blank" class="text-link">GitHub</a>
                <span class="separator">|</span>
                <a href="https://www.linkedin.com/in/tomasgorrini/" target="_blank" class="text-link">LinkedIn</a>
            </div>

            <p class="terminal-path" data-i18n="path_whois">~/who-is/Tomás</p>
            <h1 data-i18n="hero_title">
                IT Student and<br />
                <span class="text-cyan">Pentester</span>
            </h1>

            <p class="subtitle" data-i18n="hero_subtitle">
                I am a 4th-year IT student at UADE with a dedicated focus on Web Pentesting and Red Teaming. I am an active security researcher on <a href="https://app.hackthebox.com" target="_blank" class="underline-link">HackTheBox</a>, where I focus on mastering vulnerability enumeration and exploitation chains. I bring a bilingual edge with a Cambridge C1 Advanced certification, enabling me to collaborate effectively in international environments and document technical findings with precision  
            </p>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="icon-box">
                        <img src={pythonIcon.src} alt="Python" width="100" height="100" decoding="async" />
                    </div>
                    <h3>Python</h3>
                </div>
                <div class="stat-card">
                    <div class="icon-box">
                        <img src={bashIcon.src} alt="Bash" width="100" height="100" decoding="async" />
                    </div>
                    <h3>Bash Scripting</h3>
                </div>
                <div class="stat-card">
                    <div class="icon-box">
                        <img src={linuxIcon.src} alt="Linux" width="100" height="100" decoding="async" />
                    </div>
                    <h3>Linux Systems</h3>
                </div>
                <div class="stat-card">
                    <div class="icon-box">
                        <img src={burpLogo.src} alt="Burp Suite" width="100" height="100" decoding="async" />
                    </div>
                    <h3>Burp Suite</h3>
                </div>
                <div class="stat-card">
                    <div class="icon-box">
                        <img src={wireLogo.src} alt="Wireshark" width="100" height="100" decoding="async" />
                    </div>
                    <h3>Wireshark</h3>
                </div>
                <div class="stat-card">
                    <div class="icon-box">
                        <img src={nmapIcon.src} alt="Nmap" width="100" height="100" decoding="async" />
                    </div>
                    <h3 data-i18n="stat_tools">Offensive Security Tooling</h3>
                </div>
            </div>
        </header>

        <section class="achievements" id="achievements_box">
            <div class="section-header">
                <div>
                    <p class="terminal-path" data-i18n="path_achievements">~/my/recent/achievements</p>
                    <h2 data-i18n="title_machines">Machines Completed</h2>
                </div>
                <div class="total-count">
                    <span class="text-muted" id="machines-counter">Total: 0 machines</span>
                    <span class="block-cursor"></span>
                </div>
            </div>

            <div class="filters-container">
                <div class="filter-group">
                    <label for="filter-difficulty" data-i18n="filter_diff">Difficulty:</label>
                    <select id="filter-difficulty" class="custom-select">
                        <option value="ALL" data-i18n="opt_all">All</option>
                        <option value="EASY" data-i18n="opt_easy">Easy</option>
                        <option value="MEDIUM" data-i18n="opt_medium">Medium</option>
                        <option value="HARD" data-i18n="opt_hard">Hard</option>
                        <option value="INSANE" data-i18n="opt_insane">Insane</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="filter-os" data-i18n="filter_os">Operating System:</label>
                    <select id="filter-os" class="custom-select">
                        <option value="ALL" data-i18n="opt_all_os">All</option>
                        <option value="Windows">Windows</option>
                        <option value="Linux">Linux</option>
                        <option value="Other" data-i18n="opt_other">Other</option>
                    </select>
                </div>
            </div>

            <div class="carousel-wrapper">
                <button class="carousel-btn prev" id="carousel-prev" aria-label="Previous machines">&lt;</button>
                
                <div class="carousel-track-container">
                    <div class="machines-track" id="machines-track"></div>
                    <div id="no-results-msg" class="no-results hidden">
                        <p class="text-muted" data-i18n="no_results">No machines found matching the selected filters.</p>
                    </div>
                </div>

                <button class="carousel-btn next" id="carousel-next" aria-label="Next machines">&gt;</button>
            </div>
        </section>

        <section class="certifications" id="certifications">
            <div class="section-header">
                <div>
                    <p class="terminal-path" data-i18n="path_certs">~/education/certifications</p>
                    <h2 data-i18n="title_certs">Certifications</h2>
                </div>
            </div>

            <div class="certs-list">
                <div class="cert-item">
                    <div class="cert-date" id="cert-ongoing" data-i18n="cert_ongoing_date">ONGOING</div>
                    <div class="cert-details">
                        <h3 data-i18n="cert_4_title">Introduction to Hacking</h3>
                        <p class="text-muted" data-i18n="cert_4_issuer">Hack4u</p>
                    </div>
                    <div class="cert-logo">
                        <img src={hack4uIcon.src} alt="Cambridge Logo" loading="lazy" decoding="async" />
                    </div>
                </div>
                <div class="cert-item">
                    <div class="cert-date">2022</div>
                    <div class="cert-details">
                        <h3 data-i18n="cert_1_title">C1 Advanced</h3>
                        <p class="text-muted" data-i18n="cert_1_issuer">Cambridge University</p>
                    </div>
                    <div class="cert-logo">
                        <img src={cambridgeIcon.src} alt="Cambridge Logo" loading="lazy" decoding="async" />
                    </div>
                </div>

                <div class="cert-item">
                    <div class="cert-date">2026</div>
                    <div class="cert-details">
                        <h3 data-i18n="cert_2_title">Introduction to Linux</h3>
                        <p class="text-muted" data-i18n="cert_2_issuer">Hack4u</p>
                    </div>
                    <div class="cert-logo">
                        <img src={hack4uIcon.src} alt="Hack4u Logo" loading="lazy" decoding="async" />
                    </div>
                </div>

                <div class="cert-item">
                    <div class="cert-date">2025</div>
                    <div class="cert-details">
                        <h3 data-i18n="cert_3_title">The Git & GitHub Bootcamp</h3>
                        <p class="text-muted" data-i18n="cert_3_issuer">Udemy</p>
                    </div>
                    <div class="cert-logo">
                        <img src={udemyLogo.src} alt="Udemy Logo" loading="lazy" decoding="async" />
                    </div>
                </div>
            </div>
        </section>

        <section class="contact-section" id="contact">
            <div class="section-header">
                <div>
                    <p class="terminal-path" data-i18n="path_contact">~/network/connections</p>
                    <h2 data-i18n="title_contact">Get in Touch</h2>
                </div>
            </div>
            <div class="contact-box">
                <p class="text-muted" data-i18n="desc_contact">I'm always open to discussing new projects or opportunities.</p>
                <div class="contact-links">
                    <a href="mailto:tgorrinirech@gmail.com" class="btn-primary">tgorrinirech@gmail.com</a>
                    <a href="https://www.linkedin.com/in/tomasgorrini/" target="_blank" class="text-link" style="font-size: 1rem; font-weight: 600;">LinkedIn Profile &rarr;</a>
                </div>
            </div>
        </section>

        <footer>
            <p class="copyright">
                &copy; <span id="year"></span><span data-i18n="footer_dev"> Tomás G. Rech - Developed with Astro</span>
            </p>
            <div class="status">
                <span class="dot cyan"></span> <span data-i18n="footer_status">Status: Updated via GitHub</span>
            </div>
        </footer>
    </div>

    <script>
        import { Renderer, Program, Mesh, Color, Triangle } from 'ogl';
        import machinesData from '../data/machines.json'; 

        // ==========================================
        // 0. SISTEMA DE TRADUCCIÓN (DICCIONARIO)
        // ==========================================
        const translations = {
            en: {
                nav_home: "HOME", nav_machines: "MACHINES", nav_contact: "CONTACT", nav_certifications: "CERTIFICATIONS",
                btn_view: "Resume", path_whois: "~/who-is/Tomás",
                hero_title: "IT Student and<br /><span class=\"text-cyan\">Pentester</span>",
                hero_subtitle: 'I\'m a 4th-year IT student at <a href="https://uade.edu.ar/" target="_blank" class="underline-link">UADE</a> with a strong focus on <strong>Web Pentesting</strong> and <strong>Red Teaming</strong>. I\'m an active practitioner on <a href="https://app.hackthebox.com" target="_blank" class="underline-link">HackTheBox</a>, learning how things work under the hood while mastering <strong>vulnerability enumeration</strong> and <strong>exploitation chains</strong>. I am also fully comfortable working in international teams thanks to my <strong>C1 English level</strong>, which allows me to document technically and with precision',
                stat_tools: "Offensive Security Tooling", path_achievements: "~/my/recent/achievements",
                title_machines: "Machines Completed", filter_diff: "Difficulty:", filter_os: "Operating System:",
                opt_all: "All", opt_all_os: "All", opt_easy: "Easy", opt_medium: "Medium", opt_hard: "Hard", opt_insane: "Insane", opt_other: "Other",
                no_results: "No machines found matching the selected filters.",
                path_certs: "~/education/certifications", title_certs: "Certifications",
                cert_1_title: "C1 Advanced", cert_1_issuer: "Cambridge University",
                cert_2_title: "Introduction to Linux", cert_2_issuer: "Hack4u",
                cert_3_title: "The Git & GitHub Bootcamp", cert_3_issuer: "Udemy",
                cert_4_title: "Introduction to Hacking", cert_4_issuer: "Hack4u",
                cert_ongoing_date: "ONGOING",
                path_contact: "~/network/connections", title_contact: "Get in Touch",
                desc_contact: "I'm always open to discussing new projects or opportunities.",
                footer_dev: " Tomás G. Rech - Developed with Astro", footer_status: "Status: Updated via GitHub",
                card_btn: "View Details &rarr;", count_text: "Total: {count} machines"
            },
            es: {
                nav_home: "INICIO", nav_machines: "MÁQUINAS", nav_contact: "CONTACTO", nav_certifications: "CERTIFICACIONES",
                btn_view: "CV", path_whois: "~/quien-es/Tomás",
                hero_title: "Estudiante de IT y<br /><span class=\"text-cyan\">Pentester</span>",
                hero_subtitle: 'Soy estudiante de 4to año de IT en la <a href="https://uade.edu.ar/" target="_blank" class="underline-link">UADE</a>, con un fuerte enfoque en <strong>Web Pentesting</strong> y <strong>Red Teaming</strong>. Participo activamente en <a href="https://app.hackthebox.com" target="_blank" class="underline-link">HackTheBox</a>, aprendiendo cómo funcionan las cosas a bajo nivel mientras domino la <strong>enumeración de vulnerabilidades</strong> y el desarrollo de <strong>cadenas de explotación</strong>. Además, me siento totalmente cómodo trabajando en equipos internacionales gracias a mi <strong>nivel C1 de ingles</strong>, lo que me permite documentar técnicamente y con precisión',
                stat_tools: "Herramientas Ofensivas", path_achievements: "~/mis/logros/recientes",
                title_machines: "Máquinas Completadas", filter_diff: "Dificultad:", filter_os: "Sistema Operativo:",
                opt_all: "Todas", opt_all_os: "Todos", opt_easy: "Fácil", opt_medium: "Medio", opt_hard: "Difícil", opt_insane: "Insane", opt_other: "Otro",
                no_results: "No se encontraron máquinas con los filtros seleccionados.",
                path_certs: "~/educación/certificaciones", title_certs: "Certificaciones",
                cert_1_title: "C1 Advanced", cert_1_issuer: "Universidad de Cambridge",
                cert_2_title: "Introducción a Linux", cert_2_issuer: "Hack4u",
                cert_3_title: "Bootcamp de Git & GitHub", cert_3_issuer: "Udemy",
                cert_4_title: "Introducción al Hacking", cert_4_issuer: "Hack4u",
                cert_ongoing_date: "EN CURSO",
                path_contact: "~/red/conexiones", title_contact: "Contáctame",
                desc_contact: "Siempre estoy abierto a tener una conversación acerca de  nuevos proyectos u oportunidades.",
                footer_dev: " Tomás G. Rech - Desarrollado con Astro", footer_status: "Estado: Actualizado vía GitHub",
                card_btn: "Ver Detalles &rarr;", count_text: "Total: {count} máquinas"
            }
        };

        let currentLang = localStorage.getItem('preferredLanguage') || 'en';

        function updateTexts() {
            document.querySelectorAll('[data-i18n]').forEach(element => {
                const key = element.getAttribute('data-i18n');
                if (translations[currentLang][key]) element.innerHTML = translations[currentLang][key];
            });
            document.getElementById('lang-toggle').textContent = currentLang === 'en' ? 'ES' : 'EN';
            document.documentElement.lang = currentLang;
        }

        // ==========================================
        // 1. LÓGICA DEL FONDO WEBGL OPTIMIZADO
        // ==========================================
        const vertexShader = `attribute vec2 position; attribute vec2 uv; varying vec2 vUv; void main() { vUv = uv; gl_Position = vec4(position, 0.0, 1.0); }`;

        const fragmentShader = `
        precision mediump float;
        varying vec2 vUv; uniform float iTime; uniform vec3 iResolution; uniform float uScale;
        uniform vec2 uGridMul; uniform float uDigitSize; uniform float uScanlineIntensity;
        uniform float uGlitchAmount; uniform float uFlickerAmount; uniform float uNoiseAmp;
        uniform float uChromaticAberration; uniform float uDither; uniform float uCurvature;
        uniform vec3 uTint; uniform vec2 uMouse; uniform float uMouseStrength; uniform float uUseMouse;
        uniform float uPageLoadProgress; uniform float uUsePageLoadAnimation; uniform float uBrightness;

        float time;

        float hash21(vec2 p){ p = fract(p * 234.56); p += dot(p, p + 34.56); return fract(p.x * p.y); }
        float noise(vec2 p) { return sin(p.x * 10.0) * sin(p.y * (3.0 + sin(time * 0.090909))) + 0.2; }
        mat2 rotate(float angle) { float c = cos(angle); float s = sin(angle); return mat2(c, -s, s, c); }

        float fbm(vec2 p) {
          p *= 1.1; float f = 0.0; float amp = 0.5 * uNoiseAmp;
          mat2 modify0 = rotate(time * 0.02); f += amp * noise(p); p = modify0 * p * 2.0; amp *= 0.454545;
          mat2 modify1 = rotate(time * 0.02); f += amp * noise(p);
          return f;
        }

        float pattern(vec2 p, out vec2 q, out vec2 r) {
          vec2 offset1 = vec2(1.0); vec2 offset0 = vec2(0.0);
          mat2 rot01 = rotate(0.1 * time); mat2 rot1 = rotate(0.1);
          q = vec2(fbm(p + offset1), fbm(rot01 * p + offset1));
          r = vec2(fbm(rot1 * q + offset0), fbm(q + offset0));
          return fbm(p + r);
        }

        float digit(vec2 p){
            vec2 grid = uGridMul * 15.0; vec2 s = floor(p * grid) / grid; p = p * grid; vec2 q, r;
            float intensity = pattern(s * 0.1, q, r) * 1.3 - 0.03;
            if(uUsePageLoadAnimation > 0.5){
                float cellRandom = fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453);
                float cellProgress = clamp((uPageLoadProgress - (cellRandom * 0.8)) / 0.2, 0.0, 1.0);
                intensity *= smoothstep(0.0, 1.0, cellProgress);
            }
            p = fract(p); p *= uDigitSize;
            float px5 = p.x * 5.0; float py5 = (1.0 - p.y) * 5.0;
            float x = fract(px5); float y = fract(py5);
            float f = ((floor(py5) - 2.0) * (floor(py5) - 2.0) + (floor(px5) - 2.0) * (floor(px5) - 2.0)) * 0.0625;
            float brightness = step(0.1, intensity - f) * (0.2 + y * 0.8) * (0.75 + x * 0.25);
            return step(0.0, p.x) * step(p.x, 1.0) * step(0.0, p.y) * step(p.y, 1.0) * brightness;
        }

        float onOff(float a, float b, float c) { return step(c, sin(iTime + a * cos(iTime * b))) * uFlickerAmount; }
        float displace(vec2 look) {
            float y = look.y - mod(iTime * 0.25, 1.0);
            return sin(look.y * 20.0 + iTime) * 0.0125 * onOff(4.0, 2.0, 0.8) * (1.0 + cos(iTime * 60.0)) * (1.0 / (1.0 + 50.0 * y * y));
        }

        vec3 getColor(vec2 p){
            float bar = (step(mod(p.y + time * 20.0, 1.0), 0.2) * 0.4 + 1.0) * uScanlineIntensity;
            float displacement = displace(p);
            p.x += displacement + (displacement * (uGlitchAmount - 1.0));
            return vec3(1.0) * digit(p) * bar * 1.2; 
        }

        vec2 barrel(vec2 uv){
          vec2 c = uv * 2.0 - 1.0; c *= 1.0 + uCurvature * dot(c, c); return c * 0.5 + 0.5;
        }

        void main() {
            time = iTime * 0.333333;
            vec2 uv = uCurvature != 0.0 ? barrel(vUv) : vUv;
            vec3 col = getColor(uv * uScale) * uTint * uBrightness;
            gl_FragColor = vec4(col, 1.0);
        }
        `;

        function hexToRgb(hex) {
            let h = hex.replace('#', '').trim();
            if (h.length === 3) h = h.split('').map(c => c + c).join('');
            const num = parseInt(h, 16);
            return [((num >> 16) & 255) / 255, ((num >> 8) & 255) / 255, (num & 255) / 255];
        }

        function initBackgroundGL() {
            const container = document.getElementById('faulty-terminal-bg');
            if (!container) return;

            const config = {
                scale: 1, gridMul: [2, 1], digitSize: 2.3, timeScale: 0.8,
                scanlineIntensity: 0.5, glitchAmount: 1, flickerAmount: 1,
                noiseAmp: 1, chromaticAberration: 0, dither: 0, curvature: 0.05,
                tint: '#62a0ea', brightness: 0.3
            };

            // OPTIMIZACIÓN: Renderiza el canvas a una resolución mucho menor y deja que CSS lo estire
            const renderScale = 0.5; 
            const tintVec = hexToRgb(config.tint);

            const renderer = new Renderer({ dpr: 1 }); // DPR en 1 para evitar sobrecarga en Retina
            const gl = renderer.gl;
            gl.canvas.style.width = '100%';
            gl.canvas.style.height = '100%';
            gl.clearColor(0, 0, 0, 1);

            const geometry = new Triangle(gl);
            const program = new Program(gl, {
                vertex: vertexShader, fragment: fragmentShader,
                uniforms: {
                    iTime: { value: 0 },
                    iResolution: { value: new Color(1, 1, 1) }, 
                    uScale: { value: config.scale }, uGridMul: { value: new Float32Array(config.gridMul) },
                    uDigitSize: { value: config.digitSize }, uScanlineIntensity: { value: config.scanlineIntensity },
                    uGlitchAmount: { value: config.glitchAmount }, uFlickerAmount: { value: config.flickerAmount },
                    uNoiseAmp: { value: config.noiseAmp }, uCurvature: { value: config.curvature },
                    uTint: { value: new Color(tintVec[0], tintVec[1], tintVec[2]) },
                    uPageLoadProgress: { value: 0 }, uUsePageLoadAnimation: { value: 1 },
                    uBrightness: { value: config.brightness }
                }
            });

            const mesh = new Mesh(gl, { geometry, program });

            function resize() {
                const w = container.offsetWidth;
                const h = container.offsetHeight;
                renderer.setSize(w * renderScale, h * renderScale);
                program.uniforms.iResolution.value = new Color(gl.canvas.width, gl.canvas.height, gl.canvas.width / gl.canvas.height);
            }

            // OPTIMIZACIÓN: Debounce the resize observer
            let resizeTimer;
            const resizeObserver = new ResizeObserver(() => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(resize, 200);
            });
            resizeObserver.observe(container);
            resize();

            let rafId;
            let loadAnimationStart = 0;
            const timeOffset = Math.random() * 100;
            
            // OPTIMIZACIÓN: No renderizar si el usuario cambia de pestaña
            let isTabVisible = true;
            document.addEventListener("visibilitychange", () => { isTabVisible = !document.hidden; });

            const update = t => {
                rafId = requestAnimationFrame(update);
                if (!isTabVisible) return; 

                if (loadAnimationStart === 0) loadAnimationStart = t;
                const elapsed = (t * 0.001 + timeOffset) * config.timeScale;
                program.uniforms.iTime.value = elapsed;

                if (loadAnimationStart > 0 && program.uniforms.uPageLoadProgress.value < 1) {
                    program.uniforms.uPageLoadProgress.value = Math.min((t - loadAnimationStart) / 2000, 1);
                }

                renderer.render({ scene: mesh });
            };
            
            rafId = requestAnimationFrame(update);
            container.appendChild(gl.canvas);
        }

        // ==========================================
        // 2. INICIALIZACIÓN GENERAL AL CARGAR DOM
        // ==========================================
        document.addEventListener("DOMContentLoaded", () => {
            updateTexts();
            document.getElementById('lang-toggle').addEventListener('click', () => {
                currentLang = currentLang === 'en' ? 'es' : 'en';
                localStorage.setItem('preferredLanguage', currentLang);
                updateTexts();
                renderMachines(); 
            });

            const grid = document.querySelector(".stats-grid");

            if (grid) {
                grid.addEventListener("mousemove", (e) => {
                    // Obtenemos las dimensiones y posición de la grilla
                    const rect = grid.getBoundingClientRect();
                    
                    // Calculamos X e Y relativos al contenedor
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;

                    // Le pasamos las coordenadas al CSS
                    grid.style.setProperty("--mouse-x", `${x}px`);
                    grid.style.setProperty("--mouse-y", `${y}px`);
                });
            }

            // --- Lógica del Menú Hamburguesa ---
            const hamburger = document.getElementById('hamburger');
            const navLinks = document.getElementById('nav-links');
            const navLinksItems = document.querySelectorAll('.nav-links a');

            // Abrir/Cerrar menú
            hamburger.addEventListener('click', () => {
                hamburger.classList.toggle('active');
                navLinks.classList.toggle('active');
            });

            // Cerrar menú al hacer clic en un enlace (muy importante en mobile)
            navLinksItems.forEach(link => {
                link.addEventListener('click', () => {
                    hamburger.classList.remove('active');
                    navLinks.classList.remove('active');
                });
            });

            // OPTIMIZACIÓN: Navbar Scroll Pasivo para no bloquear el Main Thread
            const navbar = document.getElementById('navbar');
            let ticking = false;
            window.addEventListener('scroll', () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        window.scrollY > 50 ? navbar.classList.add('scrolled') : navbar.classList.remove('scrolled');
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });   
            
            initBackgroundGL();
            document.getElementById("year").textContent = new Date().getFullYear();

            const navCursor = document.getElementById("nav-cursor");
            setInterval(() => { navCursor.style.opacity = navCursor.style.opacity === "0" ? "1" : "0"; }, 600);

            async function runTerminalAnimation() {
                const commandEl = document.getElementById("typed-command");
                const promptSymbol = document.getElementById("prompt-symbol");
                const cursorEl = document.getElementById("cursor");
                const textToType = "whoami";
                const resultText = "Tomás Gorrini Rech";

                while (true) {
                    promptSymbol.style.display = "inline";
                    commandEl.textContent = "";
                    commandEl.classList.remove("is-output");
                    cursorEl.style.display = "inline";
                    await new Promise((r) => setTimeout(r, 1000));
                    for (let i = 0; i < textToType.length; i++) {
                        commandEl.textContent += textToType.charAt(i);
                        await new Promise((r) => setTimeout(r, 150));
                    }
                    await new Promise((r) => setTimeout(r, 400));
                    cursorEl.style.display = "none";
                    await new Promise((r) => setTimeout(r, 200));
                    promptSymbol.style.display = "none";
                    commandEl.textContent = resultText;
                    commandEl.classList.add("is-output"); 
                    cursorEl.style.display = "inline";
                    await new Promise((r) => setTimeout(r, 4000));
                }
            }
            runTerminalAnimation();

            const track = document.getElementById("machines-track");
            const btnPrev = document.getElementById("carousel-prev");
            const btnNext = document.getElementById("carousel-next");
            const filterDiff = document.getElementById("filter-difficulty");
            const filterOS = document.getElementById("filter-os");
            const counterText = document.getElementById("machines-counter");
            const noResultsMsg = document.getElementById("no-results-msg");

            let currentFilteredMachines = [...machinesData];
            let currentIndex = 0;
            let cardsPerView = getCardsPerView();

            function getCardsPerView() {
                if (window.innerWidth <= 768) return 1;
                if (window.innerWidth <= 1024) return 2;
                return 3;
            }

            function renderMachines() {
                counterText.textContent = translations[currentLang].count_text.replace('{count}', currentFilteredMachines.length);
                if (currentFilteredMachines.length === 0) {
                    track.innerHTML = "";
                    noResultsMsg.classList.remove("hidden");
                    btnPrev.disabled = true;
                    btnNext.disabled = true;
                    return;
                }
                noResultsMsg.classList.add("hidden");
                const viewBtnText = translations[currentLang].card_btn;

                // OPTIMIZACIÓN: Batch DOM updates construyendo el HTML en un string
                let htmlString = "";
                currentFilteredMachines.forEach(machine => {
                    const diffClass = machine.difficulty.toLowerCase();
                    const badgesHTML = machine.badges.map(b => `<span class="badge">${b}</span>`).join("");
                    htmlString += `
                        <div class="machine-card">
                            <div class="card-header">
                                <span class="platform">${machine.platform}</span>
                                <span class="difficulty ${diffClass}">${machine.difficulty}</span>
                            </div>
                            <h3>${machine.title}</h3>
                            <div class="badges">${badgesHTML}</div>
                            <a href="${machine.link}" target="_blank" class="card-link">${viewBtnText}</a>
                        </div>
                    `;
                });
                track.innerHTML = htmlString;
                updateCarousel();
            }

            function applyFilters() {
                const diffValue = filterDiff.value;
                const osValue = filterOS.value;
                currentFilteredMachines = machinesData.filter(m => 
                    (diffValue === "ALL" || m.difficulty === diffValue) && 
                    (osValue === "ALL" || m.os === osValue)
                );
                currentIndex = 0; 
                renderMachines();
            }

            function updateCarousel() {
                cardsPerView = getCardsPerView();
                const totalCards = currentFilteredMachines.length;
                btnPrev.disabled = currentIndex === 0;
                btnNext.disabled = currentIndex >= Math.max(0, totalCards - cardsPerView);

                if (totalCards > 0) {
                    const cardWidth = track.children[0].getBoundingClientRect().width;
                    const gap = parseFloat(getComputedStyle(track).gap) || 0;
                    track.style.transform = `translateX(-${currentIndex * (cardWidth + gap)}px)`;
                } else {
                    track.style.transform = `translateX(0px)`;
                }
            }

            filterDiff.addEventListener("change", applyFilters);
            filterOS.addEventListener("change", applyFilters);

            btnNext.addEventListener("click", () => {
                if (currentIndex < currentFilteredMachines.length - cardsPerView) {
                    currentIndex++; updateCarousel();
                }
            });
            btnPrev.addEventListener("click", () => {
                if (currentIndex > 0) {
                    currentIndex--; updateCarousel();
                }
            });

            // OPTIMIZACIÓN: Debounce resize para el carrusel
            let carruselResizeTimer;
            window.addEventListener("resize", () => {
                clearTimeout(carruselResizeTimer);
                carruselResizeTimer = setTimeout(() => {
                    if (getCardsPerView() !== cardsPerView) {
                        currentIndex = 0; 
                        updateCarousel();
                    }
                }, 150);
            });
            
            renderMachines();

        // ==========================================
            // LÓGICA DEL MODAL DE CV
            // ==========================================
            const resumeBtn = document.getElementById('resume-btn');
            const modalOverlay = document.getElementById('resume-modal');
            const closeModalBtn = document.getElementById('close-modal');
            const resumeFrame = document.getElementById('resume-frame');

            function openModal() {
                // Asigna el PDF correcto según el idioma actual leyendo desde /public
                const pdfFile = currentLang === 'en' ? '/cv_english.pdf' : '/cv_spanish.pdf';
                resumeFrame.src = pdfFile;
                
                // Muestra el modal y bloquea el scroll del fondo
                modalOverlay.classList.remove('hidden-modal');
                document.body.style.overflow = 'hidden'; 
            }

            function closeModal() {
                // Oculta el modal y restaura el scroll
                modalOverlay.classList.add('hidden-modal');
                document.body.style.overflow = ''; 
                
                // Limpia el iframe después de la transición (300ms) para que no quede cargado
                setTimeout(() => {
                    resumeFrame.src = '';
                }, 300);
            }

            // Eventos
            resumeBtn.addEventListener('click', (e) => {
                e.preventDefault();
                openModal();
            });

            closeModalBtn.addEventListener('click', closeModal);

            // Cierra el modal al hacer click afuera de la caja principal (en el fondo oscurecido)
            modalOverlay.addEventListener('click', (e) => {
                if (e.target === modalOverlay) {
                    closeModal();
                }
            });

            // Opcional pero de buena práctica: cerrar con la tecla Escape
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !modalOverlay.classList.contains('hidden-modal')) {
                    closeModal();
                }
            });
        });
    </script>

    <div id="resume-modal" class="modal-overlay hidden-modal">
        <div class="modal-content">
            <button id="close-modal" class="close-btn">&times;</button>
            <iframe id="resume-frame" src="" frameborder="0" title="Resume"></iframe>
        </div>
    </div>
</body>
</html>
