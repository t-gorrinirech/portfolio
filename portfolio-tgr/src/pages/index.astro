                no_results: "No se encontraron máquinas con los filtros seleccionados.",
                path_certs: "~/educación/certificaciones", title_certs: "Certificaciones",
                cert_1_title: "C1 Advanced", cert_1_issuer: "Universidad de Cambridge",
                cert_2_title: "Introducción a Linux", cert_2_issuer: "Hack4u",
                cert_3_title: "Bootcamp de Git & GitHub", cert_3_issuer: "Udemy",
                cert_4_title: "Introducción al Hacking", cert_4_issuer: "Hack4u",
                cert_ongoing_date: "EN CURSO",
                path_contact: "~/red/conexiones", title_contact: "Contáctame",
                desc_contact: "Siempre estoy abierto a tener una conversación acerca de  nuevos proyectos u oportunidades.",
                card_btn: "Ver Detalles &rarr;", count_text: "Total: {count} máquinas"
            }
        };

        let currentLang = localStorage.getItem('preferredLanguage') || 'en';

        function updateTexts() {
            document.querySelectorAll('[data-i18n]').forEach(element => {
                const key = element.getAttribute('data-i18n');
                if (translations[currentLang][key]) element.innerHTML = translations[currentLang][key];
            });
            document.getElementById('lang-toggle').textContent = currentLang === 'en' ? 'ES' : 'EN';
            document.documentElement.lang = currentLang;
        }

        // ==========================================
        // 1. LÓGICA DEL FONDO WEBGL OPTIMIZADO
        // ==========================================
        const vertexShader = `attribute vec2 position; attribute vec2 uv; varying vec2 vUv; void main() { vUv = uv; gl_Position = vec4(position, 0.0, 1.0); }`;

        const fragmentShader = `
        precision mediump float;
        varying vec2 vUv; uniform float iTime; uniform vec3 iResolution; uniform float uScale;
        uniform vec2 uGridMul; uniform float uDigitSize; uniform float uScanlineIntensity;
        uniform float uGlitchAmount; uniform float uFlickerAmount; uniform float uNoiseAmp;
        uniform float uChromaticAberration; uniform float uDither; uniform float uCurvature;
        uniform vec3 uTint; uniform vec2 uMouse; uniform float uMouseStrength; uniform float uUseMouse;
        uniform float uPageLoadProgress; uniform float uUsePageLoadAnimation; uniform float uBrightness;

        float time;

        float hash21(vec2 p){ p = fract(p * 234.56); p += dot(p, p + 34.56); return fract(p.x * p.y); }
        float noise(vec2 p) { return sin(p.x * 10.0) * sin(p.y * (3.0 + sin(time * 0.090909))) + 0.2; }
        mat2 rotate(float angle) { float c = cos(angle); float s = sin(angle); return mat2(c, -s, s, c); }

        float fbm(vec2 p) {
          p *= 1.1; float f = 0.0; float amp = 0.5 * uNoiseAmp;
          mat2 modify0 = rotate(time * 0.02); f += amp * noise(p); p = modify0 * p * 2.0; amp *= 0.454545;
          mat2 modify1 = rotate(time * 0.02); f += amp * noise(p);
          return f;
        }

        float pattern(vec2 p, out vec2 q, out vec2 r) {
          vec2 offset1 = vec2(1.0); vec2 offset0 = vec2(0.0);
          mat2 rot01 = rotate(0.1 * time); mat2 rot1 = rotate(0.1);
          q = vec2(fbm(p + offset1), fbm(rot01 * p + offset1));
          r = vec2(fbm(rot1 * q + offset0), fbm(q + offset0));
          return fbm(p + r);
        }

        float digit(vec2 p){
            vec2 grid = uGridMul * 15.0; vec2 s = floor(p * grid) / grid; p = p * grid; vec2 q, r;
            float intensity = pattern(s * 0.1, q, r) * 1.3 - 0.03;
            if(uUsePageLoadAnimation > 0.5){
                float cellRandom = fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453);
                float cellProgress = clamp((uPageLoadProgress - (cellRandom * 0.8)) / 0.2, 0.0, 1.0);
                intensity *= smoothstep(0.0, 1.0, cellProgress);
            }
            p = fract(p); p *= uDigitSize;
            float px5 = p.x * 5.0; float py5 = (1.0 - p.y) * 5.0;
            float x = fract(px5); float y = fract(py5);
            float f = ((floor(py5) - 2.0) * (floor(py5) - 2.0) + (floor(px5) - 2.0) * (floor(px5) - 2.0)) * 0.0625;
            float brightness = step(0.1, intensity - f) * (0.2 + y * 0.8) * (0.75 + x * 0.25);
            return step(0.0, p.x) * step(p.x, 1.0) * step(0.0, p.y) * step(p.y, 1.0) * brightness;
        }

        float onOff(float a, float b, float c) { return step(c, sin(iTime + a * cos(iTime * b))) * uFlickerAmount; }
        float displace(vec2 look) {
            float y = look.y - mod(iTime * 0.25, 1.0);
            return sin(look.y * 20.0 + iTime) * 0.0125 * onOff(4.0, 2.0, 0.8) * (1.0 + cos(iTime * 60.0)) * (1.0 / (1.0 + 50.0 * y * y));
        }

        vec3 getColor(vec2 p){
            float bar = (step(mod(p.y + time * 20.0, 1.0), 0.2) * 0.4 + 1.0) * uScanlineIntensity;
            float displacement = displace(p);
            p.x += displacement + (displacement * (uGlitchAmount - 1.0));
            return vec3(1.0) * digit(p) * bar * 1.2; 
        }

        vec2 barrel(vec2 uv){
          vec2 c = uv * 2.0 - 1.0; c *= 1.0 + uCurvature * dot(c, c); return c * 0.5 + 0.5;
        }

        void main() {
            time = iTime * 0.333333;
            vec2 uv = uCurvature != 0.0 ? barrel(vUv) : vUv;
            vec3 col = getColor(uv * uScale) * uTint * uBrightness;
            gl_FragColor = vec4(col, 1.0);
        }
        `;

        function hexToRgb(hex) {
            let h = hex.replace('#', '').trim();
            if (h.length === 3) h = h.split('').map(c => c + c).join('');
            const num = parseInt(h, 16);
            return [((num >> 16) & 255) / 255, ((num >> 8) & 255) / 255, (num & 255) / 255];
        }

        function initBackgroundGL(reduceMotion = false) {
            const container = document.getElementById('faulty-terminal-bg');
            if (!container) return;

            const config = {
                scale: 1, gridMul: [2, 1], digitSize: 2.3, timeScale: 0.5,
                scanlineIntensity: 0.3, glitchAmount: 0, flickerAmount: 0.4,
                noiseAmp: 1, chromaticAberration: 0, dither: 0, curvature: 0.05,
                tint: '#62a0ea', brightness: 0.15
            };

            // OPTIMIZACIÓN: Renderiza el canvas a una resolución mucho menor y deja que CSS lo estire
            const renderScale = 0.5; 
            const tintVec = hexToRgb(config.tint);

            const renderer = new Renderer({ dpr: 1 }); // DPR en 1 para evitar sobrecarga en Retina
            const gl = renderer.gl;
            gl.canvas.style.width = '100%';
            gl.canvas.style.height = '100%';
            gl.clearColor(0, 0, 0, 1);

            const geometry = new Triangle(gl);
            const program = new Program(gl, {
                vertex: vertexShader, fragment: fragmentShader,
                uniforms: {
                    iTime: { value: 0 },
                    iResolution: { value: new Color(1, 1, 1) }, 
                    uScale: { value: config.scale }, uGridMul: { value: new Float32Array(config.gridMul) },
                    uDigitSize: { value: config.digitSize }, uScanlineIntensity: { value: config.scanlineIntensity },
                    uGlitchAmount: { value: config.glitchAmount }, uFlickerAmount: { value: config.flickerAmount },
                    uNoiseAmp: { value: config.noiseAmp }, uCurvature: { value: config.curvature },
                    uTint: { value: new Color(tintVec[0], tintVec[1], tintVec[2]) },
                    uPageLoadProgress: { value: 0 }, uUsePageLoadAnimation: { value: 1 },
                    uBrightness: { value: config.brightness }
                }
            });

            const mesh = new Mesh(gl, { geometry, program });

            function resize() {
                const w = container.offsetWidth;
                const h = container.offsetHeight;
                renderer.setSize(w * renderScale, h * renderScale);
                program.uniforms.iResolution.value = new Color(gl.canvas.width, gl.canvas.height, gl.canvas.width / gl.canvas.height);
            }

            // OPTIMIZACIÓN: Debounce the resize observer
            let resizeTimer;
            const resizeObserver = new ResizeObserver(() => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(resize, 200);
            });
            resizeObserver.observe(container);
            resize();

            let rafId;
            let loadAnimationStart = 0;
            const timeOffset = Math.random() * 100;

            // Movimiento reducido: renderiza un solo frame estático y no arranca el loop.
            if (reduceMotion) {
                program.uniforms.uUsePageLoadAnimation.value = 0;
                program.uniforms.uPageLoadProgress.value = 1;
                program.uniforms.iTime.value = timeOffset;
                renderer.render({ scene: mesh });
                container.appendChild(gl.canvas);
                return;
            }

            // OPTIMIZACIÓN: No renderizar si el usuario cambia de pestaña
            let isTabVisible = true;
            document.addEventListener("visibilitychange", () => { isTabVisible = !document.hidden; });

            const update = t => {
                rafId = requestAnimationFrame(update);
                if (!isTabVisible) return; 

                if (loadAnimationStart === 0) loadAnimationStart = t;
                const elapsed = (t * 0.001 + timeOffset) * config.timeScale;
                program.uniforms.iTime.value = elapsed;

                if (loadAnimationStart > 0 && program.uniforms.uPageLoadProgress.value < 1) {
                    program.uniforms.uPageLoadProgress.value = Math.min((t - loadAnimationStart) / 2000, 1);
                }

                renderer.render({ scene: mesh });
            };
            
            rafId = requestAnimationFrame(update);
            container.appendChild(gl.canvas);
        }

        // ==========================================
        // 2. INICIALIZACIÓN GENERAL AL CARGAR DOM
        // ==========================================
        document.addEventListener("DOMContentLoaded", () => {
            updateTexts();

            // Respeta prefers-reduced-motion para las animaciones controladas por JS
            // (el fondo WebGL, el tipeo de la terminal y el parpadeo del cursor).
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            document.getElementById('lang-toggle').addEventListener('click', () => {
                currentLang = currentLang === 'en' ? 'es' : 'en';
                localStorage.setItem('preferredLanguage', currentLang);
                updateTexts();
                renderMachines(); 
            });

            const grid = document.querySelector(".stats-grid");

            if (grid) {
                grid.addEventListener("mousemove", (e) => {
                    // Obtenemos las dimensiones y posición de la grilla
                    const rect = grid.getBoundingClientRect();
                    
                    // Calculamos X e Y relativos al contenedor
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;

                    // Le pasamos las coordenadas al CSS
                    grid.style.setProperty("--mouse-x", `${x}px`);
                    grid.style.setProperty("--mouse-y", `${y}px`);
                });
            }

            // --- Spotlight en las cards de Experiencia ---
            document.querySelectorAll(".exp-card, .project-item").forEach((card) => {
                card.addEventListener("mousemove", (e) => {
                    const rect = card.getBoundingClientRect();
                    card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
                    card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
                });
            });

            // --- Carrusel infinito de tecnologías en mobile ---
            // Inspirado en el modelo de CircularGallery (React Bits): la posición es un
            // número virtual (offset) manejado 100% en JS, y cada card se ubica con
            // aritmética modular (position mod total width). No usamos scroll nativo del
            // navegador en ningún momento, así que no hay inercia del sistema peleando
            // contra nuestras correcciones (esa pelea era la causa de los saltos raros).
            if (grid) {
                const cards = Array.from(grid.querySelectorAll(".stat-card"));
                const cardCount = cards.length;
                const mobileQuery = window.matchMedia("(max-width: 768px)");
                const GAP = 16; // 1rem

                let active = false;
                let containerWidth = 0;
                let cardWidth = 0;
                let cellWidth = 0; // cardWidth + GAP
                let totalWidth = 0; // cellWidth * cardCount (período del wrap)
                let offset = 0; // posición virtual, en px (crece/decrece sin límite)
                let activeEl = null;

                // Interacción (drag)
                let dragging = false;
                let dragAxisLocked = null; // 'x' | 'y' | null, para no robarle el scroll vertical a la página
                let pointerId = null;
                let startX = 0;
                let startY = 0;
                let startOffset = 0;
                let lastX = 0;
                let lastT = 0;
                let velocity = 0; // px/frame

                // Loop de animación (inercia + snap): solo corre mientras hace falta,
                // no continuamente, para no gastar batería/CPU en reposo.
                let rafId = null;
                let phase = null; // 'momentum' | 'snap' | null
                let snapTarget = 0;

                function measure() {
                    if (!cards.length) return;
                    containerWidth = grid.clientWidth;
                    // offsetWidth = tamaño de layout (caja intrínseca), NO se ve afectado por
                    // el "transform: scale()" que aplicamos en render(). getBoundingClientRect()
                    // sí lo refleja, así que si mide justo cuando una card está achicada por la
                    // animación, corrompe cellWidth/totalWidth para siempre (esa era la causa de
                    // los saltos erráticos al re-medir en un resize).
                    cardWidth = cards[0].offsetWidth;
                    cellWidth = cardWidth + GAP;
                    totalWidth = cellWidth * cardCount;
                    const tallest = Math.max(...cards.map((c) => c.offsetHeight));
                    grid.style.height = tallest + "px";
                }

                function render() {
                    if (!cellWidth) return;
                    let closest = null;
                    let closestAbsPos = Infinity;

                    cards.forEach((card, i) => {
                        let pos = (i * cellWidth - offset) % totalWidth;
                        if (pos < -totalWidth / 2) pos += totalWidth;
                        if (pos > totalWidth / 2) pos -= totalWidth;

                        const distRatio = Math.min(Math.abs(pos) / cellWidth, 1);
                        const scale = 1 - distRatio * 0.16;
                        // El fondo de la card (#0e0e11) es casi igual al fondo de la página (#030303):
                        // si bajamos demasiado la opacidad, la caja directamente desaparece y solo
                        // queda flotando el texto. Con un piso de ~0.75 sigue leyéndose la caja.
                        const opacity = 1 - distRatio * 0.25;
                        const left = containerWidth / 2 - cardWidth / 2 + pos;

                        card.style.transform = `translateX(${left}px) scale(${scale})`;
                        card.style.opacity = opacity;

                        if (Math.abs(pos) < closestAbsPos) {
                            closestAbsPos = Math.abs(pos);
                            closest = card;
                        }
                    });

                    if (closest !== activeEl) {
                        if (activeEl) activeEl.classList.remove("is-active");
                        closest.classList.add("is-active");
                        activeEl = closest;
                    }
                }

                function stopLoop() {
                    if (rafId !== null) {
                        cancelAnimationFrame(rafId);
                        rafId = null;
                    }
                    phase = null;
                }

                function tick() {
                    if (phase === "momentum") {
                        offset += velocity;
                        velocity *= 0.82;
                        render();
                        if (Math.abs(velocity) < 0.5) {
                            phase = "snap";
                            snapTarget = Math.round(offset / cellWidth) * cellWidth;
                        }
                        rafId = requestAnimationFrame(tick);
                    } else if (phase === "snap") {
                        const diff = snapTarget - offset;
                        if (Math.abs(diff) < 0.4) {
                            offset = snapTarget;
                            render();
                            stopLoop();
                            return;
                        }
                        offset += diff * 0.3;
                        render();
                        rafId = requestAnimationFrame(tick);
                    }
                }

                function startLoop(initialPhase) {
                    phase = initialPhase;
                    if (rafId === null) {
                        rafId = requestAnimationFrame(tick);
                    }
                }

                // Historial corto de {tiempo, x} para estimar la velocidad de soltada.
                // Usar solo el último delta puntual es ruidoso (un solo salto grande dispara
                // una velocidad exagerada); promediar sobre una ventana reciente es mucho más estable.
                let moveHistory = [];
                const VELOCITY_WINDOW_MS = 80;
                const MAX_VELOCITY = 34; // px/frame, evita que un pico ruidoso mande el carrusel a volar
                // El drag se amplifica un poco: así no hace falta arrastrar el dedo casi un
                // ancho de card entero para pasar a la siguiente, se siente más sensible/liviano.
                const DRAG_MULTIPLIER = 1.4;

                function onPointerDown(e) {
                    if (!active) return;
                    dragging = true;
                    dragAxisLocked = null;
                    pointerId = e.pointerId;
                    startX = lastX = e.clientX;
                    startY = e.clientY;
                    startOffset = offset;
                    lastT = performance.now();
                    velocity = 0;
                    moveHistory = [{ t: lastT, x: startX }];
                    stopLoop();
                }

                function onPointerMove(e) {
                    if (!dragging || e.pointerId !== pointerId) return;
                    const dx = e.clientX - startX;
                    const dy = e.clientY - startY;

                    if (dragAxisLocked === null) {
                        if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return; // todavía no sabemos la intención
                        dragAxisLocked = Math.abs(dx) > Math.abs(dy) ? "x" : "y";
                        if (dragAxisLocked === "x") grid.setPointerCapture(pointerId);
                    }
                    if (dragAxisLocked !== "x") return; // gesto vertical: dejamos scrollear la página

                    e.preventDefault();
                    const now = performance.now();
                    lastX = e.clientX;
                    lastT = now;
                    moveHistory.push({ t: now, x: e.clientX });
                    // Solo necesitamos la ventana reciente para estimar velocidad al soltar
                    while (moveHistory.length > 1 && now - moveHistory[0].t > VELOCITY_WINDOW_MS) {
                        moveHistory.shift();
                    }

                    offset = startOffset - dx * DRAG_MULTIPLIER;
                    render();
                }

                function onPointerUp(e) {
                    if (!dragging || e.pointerId !== pointerId) return;
                    dragging = false;
                    if (dragAxisLocked === "x") {
                        const oldest = moveHistory[0];
                        const newest = moveHistory[moveHistory.length - 1];
                        const dt = Math.max(newest.t - oldest.t, 1);
                        let v = ((newest.x - oldest.x) / dt) * -16;
                        velocity = Math.max(-MAX_VELOCITY, Math.min(MAX_VELOCITY, v));
                        startLoop("momentum");
                    }
                    dragAxisLocked = null;
                }

                function onResize() {
                    if (!active) return;
                    measure();
                    render();
                }

                function setupTechCarousel(isMobile) {
                    if (isMobile && !active) {
                        active = true;
                        offset = 0;
                        grid.style.touchAction = "pan-y";
                        grid.style.cursor = "grab";
                        grid.addEventListener("pointerdown", onPointerDown);
                        grid.addEventListener("pointermove", onPointerMove);
                        grid.addEventListener("pointerup", onPointerUp);
                        grid.addEventListener("pointercancel", onPointerUp);
                        requestAnimationFrame(() => {
                            measure();
                            render();
                        });
                    } else if (!isMobile && active) {
                        active = false;
                        stopLoop();
                        grid.removeEventListener("pointerdown", onPointerDown);
                        grid.removeEventListener("pointermove", onPointerMove);
                        grid.removeEventListener("pointerup", onPointerUp);
                        grid.removeEventListener("pointercancel", onPointerUp);
                        grid.style.height = "";
                        grid.style.touchAction = "";
                        grid.style.cursor = "";
                        cards.forEach((card) => {
                            card.style.transform = "";
                            card.style.opacity = "";
                            card.classList.remove("is-active");
                        });
                        activeEl = null;
                    }
                }

                setupTechCarousel(mobileQuery.matches);
                mobileQuery.addEventListener("change", (e) => setupTechCarousel(e.matches));
                window.addEventListener("resize", onResize, { passive: true });
            }

            // --- Lógica del Menú Hamburguesa ---
            const hamburger = document.getElementById('hamburger');
            const navLinks = document.getElementById('nav-links');
            const navLinksItems = document.querySelectorAll('.nav-links a');

            function closeMobileMenu() {
                hamburger.classList.remove('active');
                navLinks.classList.remove('active');
                document.body.classList.remove('menu-open');
            }

            // Abrir/Cerrar menú
            hamburger.addEventListener('click', () => {
                const isOpen = hamburger.classList.toggle('active');
                navLinks.classList.toggle('active', isOpen);
                document.body.classList.toggle('menu-open', isOpen);
            });

            // --- Scroll suave a las secciones SIN modificar la URL (sin #seccion) ---
            function scrollToTarget(hash) {
                const target = hash && hash !== '#' ? document.querySelector(hash) : null;
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                } else {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }

            // Cerrar menú y scrollear al hacer clic en un enlace (muy importante en mobile)
            navLinksItems.forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    closeMobileMenu();
                    scrollToTarget(link.getAttribute('href'));
                });
            });

            // El nombre en la navbar siempre lleva al principio, sin tocar la URL
            document.getElementById('logo-home').addEventListener('click', () => {
                closeMobileMenu();
                scrollToTarget(null);
            });

            // OPTIMIZACIÓN: Navbar Scroll Pasivo para no bloquear el Main Thread
            const navbar = document.getElementById('navbar');
            let ticking = false;
            window.addEventListener('scroll', () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        window.scrollY > 50 ? navbar.classList.add('scrolled') : navbar.classList.remove('scrolled');
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });   
            
            initBackgroundGL(reduceMotion);

            const navCursor = document.getElementById("nav-cursor");
            if (!reduceMotion) {
                setInterval(() => { navCursor.style.opacity = navCursor.style.opacity === "0" ? "1" : "0"; }, 600);
            }

            async function runTerminalAnimation() {
                const commandEl = document.getElementById("typed-command");
                const promptSymbol = document.getElementById("prompt-symbol");
                const cursorEl = document.getElementById("cursor");
                const textToType = "whoami";
                const resultText = "Tomás Gorrini Rech";

                while (true) {
                    promptSymbol.style.display = "inline";
                    commandEl.textContent = "";
                    commandEl.classList.remove("is-output");
                    cursorEl.style.display = "inline";
                    await new Promise((r) => setTimeout(r, 1000));
                    for (let i = 0; i < textToType.length; i++) {
                        commandEl.textContent += textToType.charAt(i);
                        await new Promise((r) => setTimeout(r, 150));
                    }
                    await new Promise((r) => setTimeout(r, 400));
                    cursorEl.style.display = "none";
                    await new Promise((r) => setTimeout(r, 200));
                    promptSymbol.style.display = "none";
                    commandEl.textContent = resultText;
                    commandEl.classList.add("is-output"); 
                    cursorEl.style.display = "inline";
                    await new Promise((r) => setTimeout(r, 4000));
                }
            }
            if (reduceMotion) {
                // Sin tipeo: mostramos el resultado final directamente.
                document.getElementById("prompt-symbol").style.display = "none";
                const staticCmd = document.getElementById("typed-command");
                staticCmd.textContent = "Tomás Gorrini Rech";
                staticCmd.classList.add("is-output");
            } else {
                runTerminalAnimation();
            }

            const track = document.getElementById("machines-track");
            const btnPrev = document.getElementById("carousel-prev");
            const btnNext = document.getElementById("carousel-next");
            const filterDiff = document.getElementById("filter-difficulty");
            const filterOS = document.getElementById("filter-os");
            const counterText = document.getElementById("machines-counter");
            const noResultsMsg = document.getElementById("no-results-msg");

            let currentFilteredMachines = [...machinesData];
            let currentIndex = 0;
            let cardsPerView = getCardsPerView();

            function getCardsPerView() {
                if (window.innerWidth <= 768) return 1;
                if (window.innerWidth <= 1024) return 2;
                return 3;
            }

            function renderMachines() {
                counterText.textContent = translations[currentLang].count_text.replace('{count}', currentFilteredMachines.length);
                if (currentFilteredMachines.length === 0) {
                    track.innerHTML = "";
                    noResultsMsg.classList.remove("hidden");
                    btnPrev.disabled = true;
                    btnNext.disabled = true;
                    return;
                }
                noResultsMsg.classList.add("hidden");
                const viewBtnText = translations[currentLang].card_btn;

                // OPTIMIZACIÓN: Batch DOM updates construyendo el HTML en un string
                let htmlString = "";
                currentFilteredMachines.forEach(machine => {
                    const diffClass = machine.difficulty.toLowerCase();
                    const badgesHTML = machine.badges.map(b => `<span class="badge">${b}</span>`).join("");
                    htmlString += `
                        <div class="machine-card">
                            <div class="card-header">
                                <span class="platform">${machine.platform}</span>
                                <span class="difficulty ${diffClass}">${machine.difficulty}</span>
                            </div>
                            <h3>${machine.title}</h3>
                            <div class="badges">${badgesHTML}</div>
                            <a href="${machine.link}" target="_blank" class="card-link">${viewBtnText}</a>
                        </div>
                    `;
                });
                track.innerHTML = htmlString;
                updateCarousel();
            }

            function applyFilters() {
                const diffValue = filterDiff.value;
                const osValue = filterOS.value;
                currentFilteredMachines = machinesData.filter(m => 
                    (diffValue === "ALL" || m.difficulty === diffValue) && 
                    (osValue === "ALL" || m.os === osValue)
                );
                currentIndex = 0; 
                renderMachines();
            }

            function updateCarousel() {
                cardsPerView = getCardsPerView();
                const totalCards = currentFilteredMachines.length;
                btnPrev.disabled = currentIndex === 0;
                btnNext.disabled = currentIndex >= Math.max(0, totalCards - cardsPerView);

                if (totalCards > 0) {
                    const cardWidth = track.children[0].getBoundingClientRect().width;
                    const gap = parseFloat(getComputedStyle(track).gap) || 0;
                    track.style.transform = `translateX(-${currentIndex * (cardWidth + gap)}px)`;
                } else {
                    track.style.transform = `translateX(0px)`;
                }
            }

            filterDiff.addEventListener("change", applyFilters);
            filterOS.addEventListener("change", applyFilters);

            btnNext.addEventListener("click", () => {
                if (currentIndex < currentFilteredMachines.length - cardsPerView) {
                    currentIndex++; updateCarousel();
                }
            });
            btnPrev.addEventListener("click", () => {
                if (currentIndex > 0) {
                    currentIndex--; updateCarousel();
                }
            });

            // OPTIMIZACIÓN: Debounce resize para el carrusel
            let carruselResizeTimer;
            window.addEventListener("resize", () => {
                clearTimeout(carruselResizeTimer);
                carruselResizeTimer = setTimeout(() => {
                    if (getCardsPerView() !== cardsPerView) {
                        currentIndex = 0; 
                        updateCarousel();
                    }
                }, 150);
            });
            
            renderMachines();

        // ==========================================
            // LÓGICA DEL MODAL DE CV
            // ==========================================
            const resumeBtn = document.getElementById('resume-btn');
            const modalOverlay = document.getElementById('resume-modal');
            const closeModalBtn = document.getElementById('close-modal');
            const resumeFrame = document.getElementById('resume-frame');

            // Abre el modal con cualquier PDF (CV, informe profesional, writeup de bug bounty)
            let lastFocusedBeforeModal = null;
            function openModal(pdfFile) {
                lastFocusedBeforeModal = document.activeElement;
                resumeFrame.src = pdfFile;
                modalOverlay.classList.remove('hidden-modal');
                document.body.style.overflow = 'hidden';
                // Mueve el foco al modal (accesibilidad de teclado)
                closeModalBtn.focus();
            }

            // En mobile los <iframe> de PDF no scrollean (los navegadores muestran solo la
            // primera página, sin scroll). Ahí abrimos el PDF en una pestaña nueva, que usa el
            // visor nativo (scrolleable, con zoom y descarga). En desktop usamos el modal.
            function previewDoc(pdfFile) {
                if (window.matchMedia('(max-width: 768px)').matches) {
                    window.open(pdfFile, '_blank', 'noopener');
                } else {
                    openModal(pdfFile);
                }
            }

            function closeModal() {
                // Oculta el modal y restaura el scroll
                modalOverlay.classList.add('hidden-modal');
                document.body.style.overflow = '';

                // Devuelve el foco al elemento que abrió el modal
                if (lastFocusedBeforeModal && lastFocusedBeforeModal.focus) {
                    lastFocusedBeforeModal.focus();
                }

                // Limpia el iframe después de la transición (300ms) para que no quede cargado
                setTimeout(() => {
                    resumeFrame.src = '';
                }, 300);
            }

            // El CV depende del idioma actual y se lee desde /public
            resumeBtn.addEventListener('click', (e) => {
                e.preventDefault();
                previewDoc(currentLang === 'en' ? '/cv_english.pdf' : '/cv_spanish.pdf');
            });

            // Cualquier elemento con data-doc="/archivo.pdf" abre ese PDF (modal en desktop,
            // pestaña nueva en mobile)
            document.querySelectorAll('[data-doc]').forEach(el => {
                el.addEventListener('click', (e) => {
                    e.preventDefault();
                    previewDoc(el.getAttribute('data-doc'));
                });
            });

            closeModalBtn.addEventListener('click', closeModal);

            // Cierra el modal al hacer click afuera de la caja principal (en el fondo oscurecido)
            modalOverlay.addEventListener('click', (e) => {
                if (e.target === modalOverlay) {
                    closeModal();
                }
            });

            // Opcional pero de buena práctica: cerrar con la tecla Escape
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !modalOverlay.classList.contains('hidden-modal')) {
                    closeModal();
                }
            });
        });
    </script>

    <div id="resume-modal" class="modal-overlay hidden-modal">
        <div class="modal-content">
            <button id="close-modal" class="close-btn">&times;</button>
            <iframe id="resume-frame" src="" frameborder="0" title="Document preview"></iframe>
        </div>
    </div>
</body>
</html>
